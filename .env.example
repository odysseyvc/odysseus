# Copy to .env and fill in. .env is ignored by git and is never shown to the model.

# From @BotFather in Telegram: /newbot
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user ID. Only this account gets replies.
OWNER_TELEGRAM_ID=
# From the Claude Console
ANTHROPIC_API_KEY=
# From exa.ai
EXA_API_KEY=

# Optional
# ODYSSEUS_MODEL=claude-sonnet-5-5
# ODYSSEUS_MAX_TURNS=25
# ODYSSEUS_TASK_USD=0.50
# ODYSSEUS_DAILY_USD=3.00

# Optional: from the Composio dashboard. Without it, mail and calendar are simply not there.
# COMPOSIO_API_KEY=
# Optional: pin the clock to a zone, e.g. Asia/Kolkata, when running on a server elsewhere.
# ODYSSEUS_TZ=
# Optional: from cloud.browser-use.com. Without it, there is no browser.
# BROWSER_USE_API_KEY=
# Optional: from console.mistral.ai. Without it, files you send cannot be read.
# MISTRAL_API_KEY=
# A browser run that is signed in as you asks you first. Set to 0 to let such runs start without asking.
# ODYSSEUS_BROWSER_ASK_SIGNED_IN=
# Small changes that can be put back run without asking and are listed in the reply: additions to Attio, additions and
# edits in your own Google files, a routine set up from your own words. Set to 1 to be asked before every change.
# ODYSSEUS_ASK_EVERY_CHANGE=
# The model that looks at the pages of a PDF you send (charts, logos). Empty: the main model.
# ODYSSEUS_PAGES_MODEL=
# After this many minutes without a message, the next one starts a new conversation that carries the last few
# exchanges and your memory. Keeps each message cheap. 0 keeps one conversation for ever.
# ODYSSEUS_FRESH_AFTER_MIN=120
# The address given to DocSend when it asks who is viewing. Empty: the address of the mailbox you connected.
# A verification email can only be answered if this is that mailbox.
# ODYSSEUS_VIEWER_EMAIL=
# A short brief is sent half an hour before each meeting with someone from outside your firm. Set to 0 to turn it off.
# ODYSSEUS_MEETING_BRIEFS=
# Optional: record every task as a trace in Langfuse, to read real use and find failures. Both keys are needed.
# Note what this sends: your messages, the replies, and what tools returned, including the text of mail that was read.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# Optional: set to 1 to also record the text that mail, calendar and app tools returned. Off, only its length is recorded.
# LANGFUSE_FULL_CONTENT=

# Optional: WhatsApp as a second channel, through Meta's WhatsApp Cloud API. See the deploy guide.
# It needs the program to be reachable from the internet over HTTPS at /whatsapp, which a laptop is not.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Your own WhatsApp number with country code, digits only. Only this number is listened to.
# OWNER_WHATSAPP=
# WHATSAPP_PORT=8080
# Where reminders and routines are sent: telegram (default) or whatsapp.
# ODYSSEUS_NOTIFY_ON=

# Where the journal, memory, conversation and schedule are kept. They hold mail text in the clear, so keep this
# out of any folder that syncs to a cloud drive (OneDrive, Dropbox, iCloud). The program warns at start if it is in one.
# ODYSSEUS_DATA_DIR=var
# Optional: to let the assistant read X. Create an app at developer.x.com (OAuth 2.0, native app, read permission, return
# address http://127.0.0.1:8765/callback), put its client id here, then run: python scripts/connect_mcp.py x
# X_CLIENT_ID=
