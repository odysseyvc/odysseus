# Copy to .env and fill in. .env is ignored by git and is never shown to the model.

# From @BotFather in Telegram: /newbot
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user ID. Only this account gets replies.
OWNER_TELEGRAM_ID=
# From the Claude Console
ANTHROPIC_API_KEY=
# From exa.ai
EXA_API_KEY=

# Optional
# ODYSSEUS_MODEL=claude-sonnet-5-5
# ODYSSEUS_MAX_TURNS=25
# ODYSSEUS_TASK_USD=0.50
# ODYSSEUS_DAILY_USD=3.00

# Optional: from the Composio dashboard. Without it, mail and calendar are simply not there.
# COMPOSIO_API_KEY=
# Optional: pin the clock to a zone, e.g. Asia/Kolkata, when running on a server elsewhere.
# ODYSSEUS_TZ=
# Optional: from cloud.browser-use.com. Without it, there is no browser.
# BROWSER_USE_API_KEY=
# Optional: from console.mistral.ai. Without it, files you send cannot be read.
# MISTRAL_API_KEY=
# Optional: set to 1 to be asked before a browser run that is signed in as you.
# ODYSSEUS_BROWSER_ASK_SIGNED_IN=
